datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  GUEST
}

enum RoomStatus {
  OCCUPIED
  VACANT_CLEAN
  VACANT_DIRTY
  OUT_OF_ORDER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELLED
}

enum AttachmentType {
  ISSUE_EVIDENCE
  RESOLUTION_PROOF
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  role         UserRole    @default(STAFF)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTickets Ticket[]        @relation("AssignedStaff")
  auditLogs       TicketAuditLog[]

  @@index([role, isActive])
}

model Room {
  id          String     @id @default(uuid())
  roomNumber  String     @unique
  floor       Int
  building    String     @default("Main")
  status      RoomStatus @default(VACANT_CLEAN)
  qrSlug      String     @unique @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tickets     Ticket[]

  @@index([roomNumber])
  @@index([qrSlug])
}

model Category {
  id               String       @id @default(uuid())
  name             String       @unique
  description      String?
  defaultUrgency   UrgencyLevel @default(MEDIUM)
  targetSlaMinutes Int          @default(120)
  createdAt        DateTime     @default(now())

  tickets          Ticket[]
}

model Ticket {
  id                  String        @id @default(uuid())
  ticketNumber        String        @unique
  roomId              String
  room                Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  reportedByGuestName String?
  guestContact        String?
  guestTrackingToken  String?       @unique

  title               String        @db.VarChar(200)
  description         String        @db.Text
  urgency             UrgencyLevel  @default(MEDIUM)
  status              TicketStatus  @default(PENDING)

  assignedToId        String?
  assignedTo          User?         @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt          DateTime?
  resolutionSummary   String?       @db.Text

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  attachments         TicketAttachment[]
  auditLogs           TicketAuditLog[]

  @@index([status, urgency])
  @@index([roomId])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketAttachment {
  id             String         @id @default(uuid())
  ticketId       String
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileType       String
  attachmentType AttachmentType @default(ISSUE_EVIDENCE)
  createdAt      DateTime       @default(now())

  @@index([ticketId])
}

model TicketAuditLog {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedById    String?
  changedBy      User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  previousStatus TicketStatus?
  newStatus      TicketStatus?
  comment        String?       @db.Text
  isInternalOnly Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([ticketId])
}